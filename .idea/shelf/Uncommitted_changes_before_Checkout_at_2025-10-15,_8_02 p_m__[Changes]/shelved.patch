+                    <option>Study Room</option>
+                    <option>Computer Lab</option>
+                    <option>Sports Court</option>
+                </select>
+            </div>
+        </div>
+
+        <div class="meta" style="margin-top: 16px;">
+            <button class="btn btn-primary" type="button">Search</button>
+        </div>
+
+        <!-- Results Section -->
