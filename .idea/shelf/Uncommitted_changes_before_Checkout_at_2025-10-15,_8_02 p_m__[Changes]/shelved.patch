+                <p><strong>Date:</strong> Oct 20</p>
+                <p><strong>Status:</strong> Available</p>
+                <div class="options">
+                    <a class="btn btn-primary" href="ResourceDetails.html">Book</a>
+                </div>
+            </div>
 
+            <div class="resource-box">
+                <h3>Computer Lab 916</h3>
+                <p><strong>Time:</strong> 2–4 PM</p>
+                <p><strong>Date:</strong> Oct 21</p>
+                <p><strong>Status:</strong> Available</p>
+                <div class="options">
+                    <a class="btn btn-primary" href="ResourceDetails.html">Book</a>
+                </div>
+            </div>
+        </div>
+    </section>
