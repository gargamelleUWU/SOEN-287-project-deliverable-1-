-/* =========================================================
-   🌐 ELDAR SECTION — Global Styles, Layout, Buttons, Forms
-   ========================================================= */
-
-/* --- Global theme variables --- */
-:root {
-    --bg: #f5f6f7;
-    --shell: #f0f1f2;
-    --card: #ffffff;
-    --text: #1f2937;
-    --muted: #6b7280;
-    --border: #e5e7eb;
-    --primary: #3b82f6;
-    --primary-600: #2563eb;
-    --input: #f3f4f6;
-    --shadow: 0 10px 25px rgba(0,0,0,.06);
-    --radius: 14px;
-}
-
-* { box-sizing: border-box; }
-html, body { height: 100%; margin: 0; }
-
-body {
-    font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, "Helvetica Neue", Arial, "Noto Sans";
-    color: var(--text);
-    background: var(--bg);
-}
-
-/* --- App shell layout --- */
-.app-shell {
-    background: var(--shell);
-    min-height: 100dvh;
-    display: grid;
-    grid-template-rows: auto 1fr auto;
-}
-
-/* --- Top navigation bar --- */
-.topbar {
-    background: #2f3136;
-    color: #e5e7eb;
-    height: 56px;
-    display: flex;
-    align-items: center;
-    padding: 0 clamp(16px, 4vw, 40px);
-    gap: 28px;
-}
-
-.brand { font-weight: 700; letter-spacing: .3px; }
-.navlinks { display: flex; gap: 18px; align-items: center; margin-left: 8px; }
-.navlinks a { color: #e5e7eb; text-decoration: none; font-size: 14px; opacity: .9; }
-.navlinks a:hover { opacity: 1; }
-.nav-right { margin-left: auto; }
-.pill {
-    background: #fff; color: #111827; border-radius: 999px; padding: 6px 14px;
-    font-size: 13px; font-weight: 600;
-}
-
-/* --- Main container --- */
-.main { display: grid; place-items: center; padding: 48px 16px 72px; }
-
-.card {
-    width: min(420px, 92vw);
-    background: var(--card);
-    border: 1px solid var(--border);
-    border-radius: var(--radius);
-    box-shadow: var(--shadow);
-    padding: 28px;
-}
-
-.logo-center { text-align: center; font-weight: 700; margin-bottom: 10px; font-size: 20px; }
-.title { font-size: 28px; font-weight: 800; text-align: center; margin: 6px 0 4px; }
-.subtitle { color: var(--muted); text-align: center; font-size: 13px; line-height: 1.4; margin-bottom: 18px; }
-
-/* --- Form fields --- */
-.field { display: grid; gap: 6px; margin: 12px 0; }
-.label { font-size: 13px; color: var(--muted); }
-
-.input {
-    width: 100%;
-    border: 1px solid var(--border);
-    background: var(--input);
-    border-radius: 10px;
-    padding: 12px 12px;
-    font-size: 14px;
-    outline: none;
-    transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
-}
-
-.input:focus {
-    background: #fff;
-    border-color: var(--primary);
-    box-shadow: 0 0 0 3px rgba(59,130,246,.2);
-}
-
-/* --- Buttons --- */
-.btn {
-    display: inline-flex;
-    align-items: center;
-    justify-content: center;
-    gap: 10px;
-    width: 100%;
-    border-radius: 10px;
-    border: 1px solid var(--border);
-    padding: 12px 14px;
-    font-weight: 600;
-    font-size: 14px;
-    cursor: pointer;
-    background: #fff;
-    transition: background .15s ease, transform .02s ease, border-color .15s ease;
-}
-
-.btn:active { transform: translateY(1px); }
-.btn-primary { background: var(--primary); color: #fff; border-color: var(--primary); }
-.btn-primary:hover { background: var(--primary-600); border-color: var(--primary-600); }
-.btn-ghost:hover { background: #f9fafb; }
-
-/* --- Misc utilities --- */
-.meta { display: grid; gap: 8px; justify-items: center; margin-top: 10px; font-size: 13px; }
-.meta a { color: var(--muted); text-decoration: none; }
-.meta a:hover { text-decoration: underline; color: #374151; }
-
-.divider { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12px; color: var(--muted); font-size: 12px; margin: 12px 0 6px; }
-.divider::before, .divider::after { content: ""; height: 1px; background: var(--border); }
-
-footer { color: var(--muted); font-size: 12px; text-align: center; padding: 28px 16px 40px; }
-
-.mt-8 { margin-top: 8px; }
-.mt-12 { margin-top: 12px; }
-.mt-16 { margin-top: 16px; }
-.text-center { text-align: center; }
-
-/* =========================================================
-   📊 FELIX SECTION — Dashboard, Resource Grid, Admin Styles
-   ========================================================= */
-
-/* --- Statistics grid on admin dashboard --- */
-.felix-grid-container {
-    display: grid;
-    grid-template-columns: repeat(2, 1fr);
-    grid-gap: 20px;
-    width: 400px;
-    margin: 20px auto;
-}
-
-/* --- General container boxes --- */
-.felix-box {
-    background-color: rgb(235, 235, 235);
-    color: rgb(0, 0, 0);
-    padding: 20px;
-    text-align: center;
-    font-family: 'Gill Sans', Calibri, 'Trebuchet MS', sans-serif;
-    border: 8px;
-}
-
-/* --- Booking requests layout --- */
-.resource-container {
-    display: grid;
-    grid-template-columns: repeat(auto-fit, minmax(250px, 250px));
-    grid-gap: 20px;
-    margin: 20px;
-}
-
-.resource-display-container {
-    display: grid;
-    grid-template-columns: repeat(auto-fit, minmax(150px, 150px));
-    grid-gap: 20px;
-    margin: 20px;
-}
-
-/* --- Resource info boxes --- */
-.resource-box, .resource-display-box, .resource-display-box-bold {
-    background-color: rgb(235, 235, 235);
-    color: rgb(0, 0, 0);
-    padding: 20px;
-    text-align: center;
-    font-family: 'Gill Sans', Calibri, 'Trebuchet MS', sans-serif;
-    border: 8px;
-}
-
-/*
-Display box for the titles of the Admin Dashboard
-*/
-.resource-display-box-bold {
-    background-color: rgb(235, 235, 235);
-    color: rgb(0, 0, 0);
-    padding: 20px;
-    text-align: center;
-    font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
-    border: 8px;
-    font-weight: bold;
-}
-
-/*
-
-*/
-.resource-display-box-bold p {
-    border-bottom: 1px solid gray;
-    font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
-    padding: 5px 0;
-}
-
-.resource-display-box-bold p:last-child {
-    font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
-    border-bottom: none;
-}
-
-/*
-Display box for the resource of the Admin Dashboard
-*/
-.resource-display-box {
-    background-color: rgb(235, 235, 235);
-    color: rgb(0, 0, 0);
-    padding: 20px;
-    font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
-    text-align: center;
-    border: 8px;
-}
-
-/*
-
