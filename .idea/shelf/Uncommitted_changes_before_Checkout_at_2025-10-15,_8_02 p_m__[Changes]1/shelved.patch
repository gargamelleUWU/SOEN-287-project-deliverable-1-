+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <title>Booking Requests · University Resources</title>
+    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
+    <link rel="stylesheet" href="styles.css" />
+</head>
+<body>
+<!-- Top Navigation -->
+<header class="topbar">
+    <div class="brand">University Resources</div>
+    <nav class="navlinks" aria-label="Primary">
+        <a href="index.html">Home</a>
+        <a href="BrowseResources.html">Resources</a>
+        <a href="BookingDashboard.html">Bookings</a>
+        <a class="active" href="AdminDashboard.html">Admin</a>
+        <div class="more">
+            <button class="more-btn" type="button">More ▾</button>
+            <div class="more-menu">
+                <a href="ResourceSearch.html">Search</a>
+                <a href="ManageResources.html">Manage Resources</a>
+                <a href="Statistics.html">Statistics</a>
+                <a href="calendar.html">Calendar</a>
+                <a href="login.html">Login / Signup</a>
+            </div>
+        </div>
+    </nav>
+    <div class="nav-right">
+        <a class="pill" href="login.html">Login</a>
+    </div>
+</header>
+
+<!-- Main -->
+<main class="main">
+    <section class="card" style="max-width: 900px;">
+        <h1 class="title">Booking Requests</h1>
+        <p class="subtitle">Review and respond to pending booking requests from users.</p>
+
+        <div class="resource-container">
+            <!-- Request 1 -->
+            <div class="resource-box">
+                <h3>Study Room EV301</h3>
+                <p><strong>User:</strong> Sarah Lee</p>
+                <p><strong>Date:</strong> Oct 22</p>
+                <p><strong>Time:</strong> 10:00 – 12:00</p>
+                <div class="options">
+                    <button class="btn btn-primary" onclick="approve('Sarah Lee', 'EV301')">Approve</button>
+                    <button class="btn" onclick="reject('Sarah Lee', 'EV301')">Reject</button>
+                </div>
+            </div>
+
+            <!-- Request 2 -->
+            <div class="resource-box">
+                <h3>Computer Lab 916</h3>
+                <p><strong>User:</strong> David Kim</p>
+                <p><strong>Date:</strong> Oct 23</p>
+                <p><strong>Time:</strong> 14:00 – 16:00</p>
+                <div class="options">
+                    <button class="btn btn-primary" onclick="approve('David Kim', 'Lab 916')">Approve</button>
+                    <button class="btn" onclick="reject('David Kim', 'Lab 916')">Reject</button>
+                </div>
+            </div>
+
+            <!-- Request 3 -->
+            <div class="resource-box">
+                <h3>Sports Court L107</h3>
+                <p><strong>User:</strong> Elena Rossi</p>
+                <p><strong>Date:</strong> Oct 24</p>
+                <p><strong>Time:</strong> 15:00 – 17:00</p>
+                <div class="options">
+                    <button class="btn btn-primary" onclick="approve('Elena Rossi', 'Court L107')">Approve</button>
+                    <button class="btn" onclick="reject('Elena Rossi', 'Court L107')">Reject</button>
+                </div>
+            </div>
+        </div>
+    </section>
+</main>
+
+<!-- Footer -->
+<footer>© 2024 University Resources</footer>
+
+<!-- JavaScript -->
+<script>
+    // Dropdown logic
+    document.addEventListener("click", (e) => {
+        const wrap = e.target.closest(".more");
+        document.querySelectorAll(".more").forEach((d) => d.classList.remove("open"));
+        if (wrap && e.target.closest(".more-btn")) wrap.classList.toggle("open");
+    });
+
+    // Approve / Reject logic
+    function approve(user, resource) {
+        alert(`✅ Booking for ${resource} by ${user} has been approved.`);
+    }
+
+    function reject(user, resource) {
+        if (confirm(`Are you sure you want to reject ${user}'s request for ${resource}?`)) {
+            alert(`❌ Booking for ${resource} by ${user} has been rejected.`);
+        }
+    }
+</script>
+</body>
+</html>
