+<main class="main">
+    <section class="card" style="max-width: 900px;">
+        <h1 class="title">Search Resources</h1>
+        <p class="subtitle">Find rooms, labs, and spaces by name, type, or location.</p>
+
+        <!-- Search Input -->
+        <div class="field" style="margin-top: 20px;">
+            <label class="label">Search</label>
+            <input id="searchInput" class="input" type="text" placeholder="e.g., EV301, Lab, Sports Court" />
+            <button class="btn btn-primary mt-12" onclick="performSearch()">Search</button>
+        </div>
+
+        <!-- Results -->
+        <div id="results" class="resource-container" style="margin-top: 24px;">
+            <!-- Search results will appear here -->
+        </div>
+    </section>
+</main>
+
+<!-- Footer -->
+<footer>© 2024 University Resources</footer>
+
+<script>
+    // Dropdown logic
+    document.addEventListener("click", (e) => {
+        const wrap = e.target.closest(".more");
+        document.querySelectorAll(".more").forEach((d) => d.classList.remove("open"));
+        if (wrap && e.target.closest(".more-btn")) wrap.classList.toggle("open");
+    });
+
+    const resources = [
+        { name: "Study Room EV301", type: "Study Room", location: "EV Building" },
+        { name: "Computer Lab 916", type: "Computer Lab", location: "Hall Building" },
+        { name: "Sports Court L107", type: "Sports Court", location: "Loyola" }
+    ];
+
+    function performSearch() {
+        const query = document.getElementById("searchInput").value.toLowerCase().trim();
+        const resultsDiv = document.getElementById("results");
+        resultsDiv.innerHTML = "";
+
+        if (!query) {
+            resultsDiv.innerHTML = "<p style='color: var(--muted);'>Please enter a search term.</p>";
+            return;
+        }
+
+        const matches = resources.filter(r =>
+            r.name.toLowerCase().includes(query) ||
+            r.type.toLowerCase().includes(query) ||
+            r.location.toLowerCase().includes(query)
+        );
+
+        if (matches.length === 0) {
+            resultsDiv.innerHTML = "<p style='color: var(--muted);'>No results found.</p>";
+            return;
+        }
+
+        matches.forEach(r => {
+            const div = document.createElement("div");
+            div.className = "resource-box";
+            div.innerHTML = `
+          <h3>${r.name}</h3>
+          <p><strong>Type:</strong> ${r.type}</p>
+          <p><strong>Location:</strong> ${r.location}</p>
+          <div class="options">
+            <a class="btn btn-primary" href="BookingRequest.html">Book</a>
+          </div>
+        `;
+            resultsDiv.appendChild(div);
+        });
+    }
+</script>
+</body>
+</html>
